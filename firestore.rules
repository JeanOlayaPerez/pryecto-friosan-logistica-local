rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(path)
        ? get(path).data
        : null;
    }

    function userRole() {
      let data = userData();
      let raw = data == null
        ? null
        : (data.role != null ? data.role :
          data.Role != null ? data.Role :
          data.rol != null ? data.rol :
          data.Rol != null ? data.Rol :
          null);
      return raw == null ? null : raw.lower();
    }

    function hasRole(list) {
      return request.auth != null && userRole() != null && userRole() in list;
    }

    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function canAnonFinalize() {
      return request.resource.data.status == 'terminado'
        && resource.data.status != 'terminado'
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'updatedAt', 'processEndTime', 'history']);
    }

    match /trucks/{truckId} {
      allow read: if request.auth != null;
      // Porteria, comercial (agenda diaria) y operaciones (camion no previsto en
      // porteria) crean; Recepcion actualiza estados; Admin todo.
      allow create: if hasRole(['porteria', 'comercial', 'operaciones', 'admin', 'superadmin']);
      // "porteria" tambien actualiza (estado, anden, datos de conductor, foto
      // de guia) desde su propio panel (PorteriaDesk), por eso esta en la lista.
      allow update: if hasRole(['porteria', 'recepcion', 'comercial', 'operaciones', 'calidad', 'admin', 'superadmin', 'visor'])
        || (isAnonymous() && canAnonFinalize());
      // Solo admin/superadmin eliminan: la UI ya restringe el boton de borrado
      // a esos roles, "recepcion" no lo necesita en las reglas.
      allow delete: if hasRole(['admin', 'superadmin']);
    }

    match /clients/{clientId} {
      allow read: if hasRole(['comercial', 'operaciones', 'clientes', 'gerencia', 'admin', 'superadmin']);
      allow create, update, delete: if hasRole(['comercial', 'operaciones', 'admin', 'superadmin']);
    }

    match /securityReports/{reportId} {
      allow read: if hasRole(['gerencia', 'admin', 'superadmin']);
      allow create, update, delete: if hasRole(['admin', 'superadmin']);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
